# Convex development deployment. `pnpm convex:dev` writes real local values.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Canonical public origin used for redirects and metadata.
BENCHBAZAAR_ENVIRONMENT=local
PUBLIC_SITE_URL=http://localhost:3000
CONVEX_ENVIRONMENT=local

# WorkOS server configuration. Never prefix secrets with VITE_.
WORKOS_ENVIRONMENT=staging
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
WORKOS_COOKIE_PASSWORD=

# Optional operational integrations. Treat tokens as secrets.
ERROR_REPORTING_DSN=
